{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "disabled_mcps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disabled_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Sisyphus",
          "oracle",
          "librarian",
          "explore",
          "frontend-ui-ux-engineer",
          "document-writer",
          "multimodal-looker"
        ]
      }
    },
    "disabled_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["playwright"]
      }
    },
    "disabled_hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "todo-continuation-enforcer",
          "context-window-monitor",
          "session-recovery",
          "session-notification",
          "comment-checker",
          "grep-output-truncator",
          "tool-output-truncator",
          "directory-agents-injector",
          "directory-readme-injector",
          "empty-task-response-detector",
          "think-mode",
          "anthropic-context-window-limit-recovery",
          "rules-injector",
          "background-notification",
          "auto-update-checker",
          "startup-toast",
          "keyword-detector",
          "agent-usage-reminder",
          "non-interactive-env",
          "interactive-bash-session",
          "empty-message-sanitizer",
          "thinking-block-validator",
          "ralph-loop",
          "preemptive-compaction",
          "compaction-context-injector",
          "claude-code-hooks",
          "auto-slash-command",
          "edit-error-recovery"
        ]
      }
    },
    "disabled_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["init-deep"]
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "plan": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "Sisyphus": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "OpenCode-Builder": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "Planner-Sisyphus": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "oracle": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "librarian": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "explore": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "frontend-ui-ux-engineer": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "document-writer": {
          "$ref": "#/definitions/AgentOverrideConfig"
        },
        "multimodal-looker": {
          "$ref": "#/definitions/AgentOverrideConfig"
        }
      }
    },
    "claude_code": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "boolean"
        },
        "commands": {
          "type": "boolean"
        },
        "skills": {
          "type": "boolean"
        },
        "agents": {
          "type": "boolean"
        },
        "hooks": {
          "type": "boolean"
        },
        "plugins": {
          "type": "boolean"
        },
        "plugins_override": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "google_auth": {
      "type": "boolean"
    },
    "sisyphus_agent": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "default_builder_enabled": {
          "type": "boolean"
        },
        "planner_enabled": {
          "type": "boolean"
        },
        "replace_plan": {
          "type": "boolean"
        }
      }
    },
    "comment_checker": {
      "type": "object",
      "properties": {
        "custom_prompt": {
          "type": "string",
          "description": "Custom prompt to replace the default warning message. Use {{comments}} placeholder for detected comments XML."
        }
      }
    },
    "experimental": {
      "type": "object",
      "properties": {
        "aggressive_truncation": {
          "type": "boolean"
        },
        "auto_resume": {
          "type": "boolean"
        },
        "preemptive_compaction": {
          "type": "boolean",
          "description": "Enable preemptive compaction at threshold (default: true since v2.9.0)"
        },
        "preemptive_compaction_threshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.95,
          "description": "Threshold percentage to trigger preemptive compaction (default: 0.80)"
        },
        "truncate_all_tool_outputs": {
          "type": "boolean",
          "description": "Truncate all tool outputs, not just whitelisted tools (default: false). Tool output truncator is enabled by default - disable via disabled_hooks."
        },
        "dynamic_context_pruning": {
          "type": "object",
          "description": "Dynamic context pruning configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "notification": {
              "type": "string",
              "enum": ["off", "minimal", "detailed"],
              "default": "detailed"
            },
            "turn_protection": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "turns": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10,
                  "default": 3
                }
              }
            },
            "protected_tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "strategies": {
              "type": "object",
              "properties": {
                "deduplication": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    }
                  }
                },
                "supersede_writes": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "aggressive": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                },
                "purge_errors": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "turns": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 20,
                      "default": 5
                    }
                  }
                }
              }
            }
          }
        },
        "dcp_for_compaction": {
          "type": "boolean",
          "description": "Enable DCP (Dynamic Context Pruning) for compaction - runs first when token limit exceeded (default: false)"
        }
      }
    },
    "auto_update": {
      "type": "boolean"
    },
    "skills": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "recursive": {
                        "type": "boolean"
                      },
                      "glob": {
                        "type": "string"
                      }
                    },
                    "required": ["path"]
                  }
                ]
              }
            },
            "enable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/definitions/SkillDefinition"
              }
            ]
          }
        }
      ]
    },
    "ralph_loop": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ralph loop functionality (default: false - opt-in feature)"
        },
        "default_max_iterations": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Default max iterations if not specified in command (default: 100)"
        },
        "state_dir": {
          "type": "string",
          "description": "Custom state file directory relative to project root (default: .opencode/)"
        }
      }
    },
    "mcp_api_keys": {
      "type": "object",
      "properties": {
        "exa_api_key": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "AgentPermission": {
      "type": "object",
      "properties": {
        "edit": {
          "enum": ["ask", "allow", "deny"]
        },
        "bash": {
          "oneOf": [
            {
              "enum": ["ask", "allow", "deny"]
            },
            {
              "type": "object",
              "additionalProperties": {
                "enum": ["ask", "allow", "deny"]
              }
            }
          ]
        },
        "webfetch": {
          "enum": ["ask", "allow", "deny"]
        },
        "doom_loop": {
          "enum": ["ask", "allow", "deny"]
        },
        "external_directory": {
          "enum": ["ask", "allow", "deny"]
        }
      }
    },
    "AgentOverrideConfig": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prompt": {
          "type": "string"
        },
        "prompt_append": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "disable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "mode": {
          "enum": ["subagent", "primary", "all"]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "permission": {
          "$ref": "#/definitions/AgentPermission"
        }
      }
    },
    "SkillDefinition": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "subtask": {
          "type": "boolean"
        },
        "argument-hint": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "compatibility": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "allowed-tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disable": {
          "type": "boolean"
        }
      }
    }
  }
}
